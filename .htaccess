# Conservative Apache settings for cPanel shared hosting.
Options -Indexes

ErrorDocument 404 /404.html

# This site may be checked out directly into a domain's document root for git pull updates.
# Do not expose Git metadata through the web server.
<IfModule mod_alias.c>
  RedirectMatch 404 "(?i)/\.git(?:/|$)"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

# Product data changes more frequently than the site's bundled styling and scripts.
# Revalidate the landing page and product list so cPanel visitors see current picks.
<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|products\.js)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# If installed in a subfolder (for example /picks/), change ErrorDocument to /picks/404.html.
