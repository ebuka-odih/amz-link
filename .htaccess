# Conservative Apache settings for cPanel shared hosting.
Options -Indexes

ErrorDocument 404 /404.html

# This site may be checked out directly into a domain's document root for git pull updates.
# Do not expose Git metadata through the web server.
<IfModule mod_alias.c>
  RedirectMatch 404 "(?i)/\.git(?:/|$)"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

# If installed in a subfolder (for example /picks/), change ErrorDocument to /picks/404.html.
